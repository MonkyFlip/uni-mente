# ================================================================
#  UniMente — Variables de entorno (.env)
#  Copia a .env y edita antes de correr:
#    docker compose up --build -d
#
#  NUNCA subas este archivo a Git (.gitignore ya lo excluye)
# ================================================================

# ── Base de datos ─────────────────────────────────────────────────
# Requisitos SQL Server: min 8 chars, mayus + minus + numero + simbolo
DB_PASSWORD=UniMente_DB_2026!
DB_PORT=1433
DB_NAME=unimente
# true  → confiar en certificado autofirmado de SQL Server (usar en EC2/local)
# false → exigir certificado CA real (usar con cert de producción real)
DB_TRUST_CERT=true

# ── JWT ───────────────────────────────────────────────────────────
# Genera uno seguro:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CAMBIA_ESTE_SECRETO_EN_PRODUCCION_96CHARS_MINIMO_AQUI
JWT_EXPIRES=8h

# ── Restauracion de emergencia ────────────────────────────────────
RESTORE_SECRET=UniMente_Restore_Cambia_Esto_2026!

# ── Servidor ──────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── CORS: origenes permitidos ─────────────────────────────────────
# Agregar la IP publica actual de la EC2 o dominio si aplica.
# La IP cambia cada vez que se apaga/enciende la EC2 sin Elastic IP.
ALLOWED_ORIGINS=https://aws.d1mrcwf1ifucba.amplifyapp.com,http://localhost:5173,http://localhost:3000

# ── Contraseñas del Seed (minimo 8 caracteres) ───────────────────
SEED_ADMIN_PASSWORD=Admin1234!
SEED_ADMIN_BRENDA_PASSWORD=Brenda1234!
SEED_ADMIN_ABRIL_PASSWORD=Abril1234!
SEED_ADMIN_MAI_PASSWORD=Mai12345!
SEED_DEFAULT_PASSWORD=Password123!
