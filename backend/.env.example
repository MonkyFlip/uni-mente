# ================================================================
#  UniMente Backend — Variables de entorno (MSSQL)
#  Copia como .env y completa los valores.
#  NUNCA subas .env a Git — ya está en .gitignore.
# ================================================================

# ─── SQL Server ───────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=UniMente_DB_2026!       # >= 8 chars, mayus+minus+num+especial
DB_NAME=unimente
# En produccion: false para validar certificado TLS real del servidor
# En desarrollo con Docker: true (certificado auto-firmado)
DB_TRUST_CERT=true

# ─── JWT ─────────────────────────────────────────────────────────
# OWASP A02: secreto aleatorio de al menos 32 caracteres
JWT_SECRET=cambia_este_secreto_por_uno_aleatorio_de_minimo_32_chars
JWT_EXPIRES=8h

# ─── Restauracion de emergencia ───────────────────────────────────
# OWASP A01: clave del servidor, nunca en frontend ni logs
# Solo funciona cuando la tabla Usuario tiene 0 registros
RESTORE_SECRET=UniMente_Restore_2026_SuperSecreta_Cambiar_En_Prod

# ─── Servidor ─────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── CORS ─────────────────────────────────────────────────────────
# OWASP A05: lista blanca de orígenes permitidos (separados por coma)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Contraseñas del Seed (CWE-547 fix) ──────────────────────────
# En produccion usa contraseñas fuertes generadas aleatoriamente.
SEED_ADMIN_PASSWORD=Admin1234!
SEED_ADMIN_BRENDA_PASSWORD=Brenda123!
SEED_ADMIN_ABRIL_PASSWORD=Abril123!
SEED_ADMIN_MAI_PASSWORD=Mai123!
SEED_DEFAULT_PASSWORD=Password123!
