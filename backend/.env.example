# ================================================================
#  UniMente — Variables de entorno (.env)
#  Copia a .env y configura antes de correr docker compose up --build -d
#  NUNCA subas este archivo a Git (.gitignore ya lo excluye)
# ================================================================

# ── Base de datos ─────────────────────────────────────────────────
# Requisitos SQL Server: min 8 chars, mayus + minus + numero + simbolo
DB_PASSWORD=UniMente_DB_2026!
DB_PORT=1433
DB_NAME=unimente
DB_TRUST_CERT=true

# ── JWT ───────────────────────────────────────────────────────────
# Genera uno seguro en la EC2:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=d383ca6eef1f457961981da0bedc0b57f6f18d64af6f19f30a6c5ad097ee8d78311e5ab98b09a4b17b8268cfa8425def
JWT_EXPIRES=8h

# ── Restauracion de emergencia ────────────────────────────────────
RESTORE_SECRET=UniMente_Restore_Cambia_Esto_En_Produccion!

# ── Servidor ──────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── CORS: frontend Amplify + desarrollo local ─────────────────────
ALLOWED_ORIGINS=https://aws.d1mrcwf1ifucba.amplifyapp.com,http://localhost:5173,http://localhost:3000

